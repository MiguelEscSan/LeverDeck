<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows adapters (SendInput, DnsServiceRegister, DPAPI). Domain, Application and Protocol stay net10.0. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Part of the Native AOT executable: keep trimming and AOT analyzers on. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- CsWin32 generates unsafe, blittable interop code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The DnsService* structs are architecture-specific. win-x64 is the only published runtime (docs/ARCHITECTURE.md). -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LeverDeck.Application/LeverDeck.Application.csproj" />
    <ProjectReference Include="../LeverDeck.Protocol/LeverDeck.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LeverDeck.Infrastructure.Tests" />
  </ItemGroup>
</Project>
